# Copy to .env and edit. Nothing here is required to boot except the
# database URL -- the defaults run entirely offline apart from the LLM call.

ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------
# Host "db" works inside docker compose; use localhost when running the API
# on your machine against the compose database.
DATABASE_URL=postgresql+psycopg://eduos:eduos@localhost:5432/eduos

# --- Uploads -----------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=25

# --- Chunking ----------------------------------------------------------
# Raise the target for dense textbook prose, lower it for sparse notes.
# Change these and re-run POST /documents/{id}/reingest to compare.
CHUNK_TARGET_WORDS=220
CHUNK_OVERLAP_WORDS=45
CHUNK_MIN_WORDS=25

# --- Embeddings --------------------------------------------------------
# fastembed downloads a ~130 MB model once, then runs offline.
# Switching provider or model means re-ingesting every document, and
# changing EMBEDDING_DIM means dropping the document_chunks table.
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32

# For OpenAI embeddings instead:
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Retrieval ---------------------------------------------------------
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
# When a question asks for a formula, equation or reaction, an extra search
# runs over only those passages that actually contain notation. This is how
# "formula for coulomb force" finds the equation instead of the definition.
NOTATION_TOP_K=10
RRF_K=60
RERANK_TOP_N=6
MIN_CONTEXT_SCORE=0.0
# How well a student's own notes must match before the built-in NCERT
# chapters are left out. Their own material always goes first; the textbook
# only joins in when their notes do not cover the question well enough.
# Cosine similarity, so comparable across questions.
#   higher -> leans on the textbook more often
#   lower  -> stays inside the student's own material
OWN_MATERIAL_THRESHOLD=0.72
ENABLE_QUERY_REWRITING=true
ENABLE_RERANKING=true

# --- Spelling ----------------------------------------------------------
# Typos are corrected against words found in your own uploaded documents,
# not a dictionary -- so "coulumb" becomes "coulomb" only if "coulomb"
# actually appears in your material.
# 0.4 catches most single-letter errors while keeping genuinely different
# words apart (mitosis vs meiosis scores 0.33, safely below).
# Raise it if unrelated words get swapped; lower it to catch sloppier
# typing, at the risk of wrong corrections.
ENABLE_SPELLING_CORRECTION=true
SPELLING_MIN_SIMILARITY=0.4

# --- Generation --------------------------------------------------------
# Use LLM_PROVIDER=echo to exercise the whole pipeline with no API key.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.2

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
